<?xml version="1.0" encoding="UTF-8"?>
<!--
    Sobre SOAP 1.1 de prueba para el Bloque 3 de la practica GA-U4.

    El WSDL que genera DefaultWsdl11Definition publica un enlace SOAP 1.1, asi
    que el sobre y las cabeceras son las de SOAP 1.1.

    POST de este archivo a http://localhost:8080/ws con las cabeceras
    Content-Type "text/xml; charset=utf-8" y SOAPAction
    "https://agrotrace.uteq.edu.ec/soap/certificacion/Certificar".

    Para comprobar que el contrato valida de verdad, cambie CACAO-1 por
    CACAO-1 y repita: el motor SOAP debe devolver un SOAP Fault, no un 500.
-->
<soap:Envelope xmlns:soap="http://schemas.xmlsoap.org/soap/envelope/"
               xmlns:cert="https://agrotrace.uteq.edu.ec/soap/certificacion">
	<soap:Header/>
	<soap:Body>
		<cert:CertificarLoteRequest>
			<cert:codigoLote>CACAO-1</cert:codigoLote>
			<cert:cedulaTecnico>1204567890</cert:cedulaTecnico>
		</cert:CertificarLoteRequest>
	</soap:Body>
</soap:Envelope>

